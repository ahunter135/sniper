<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.austin.watchlink-sniper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/austinhunter/dev/watchlink-sniper/run.sh</string>
    </array>
    <!-- KeepAlive=true: launchd restarts run.sh whenever it exits. run.sh now
         exec's a persistent `python sniper.py loop`, so this is a daemon, not
         a timer. We replaced StartInterval=30 because 30s polling lost every
         giveaway race; the loop polls every 2s internally. -->
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <!-- Throttle restart attempts so a crash loop doesn't hammer the API. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/austinhunter/dev/watchlink-sniper/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/austinhunter/dev/watchlink-sniper/logs/launchd.err.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/austinhunter/dev/watchlink-sniper</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
